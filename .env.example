# Copy to .env and fill in. Only public (client-safe) values belong here.
EXPO_PUBLIC_APP_ENV=development

# mock  = demo accounts on-device, no backend (use until Supabase is set up)
# supabase = real phone OTP + database
EXPO_PUBLIC_AUTH_MODE=mock

# Required when EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
