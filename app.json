{
  "expo": {
    "name": "App Name TBD",
    "slug": "app-name-tbd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appnametbd",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.healthathon.appnametbd"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9DDE9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.healthathon.appnametbd"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6B8CF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The care team uses the camera to capture paper records (ANC cards, lab reports).",
          "photosPermission": "Choose a photo of a paper record to transcribe."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock the app with Face ID to protect health information."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E0709A"
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
