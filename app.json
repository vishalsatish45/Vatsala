{
  "expo": {
    "name": "Vatsala",
    "slug": "app-name-tbd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appnametbd",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.healthathon.appnametbd"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3B3CB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.healthathon.appnametbd"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9D3E1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The care team uses the camera to capture paper records (ANC cards, lab reports).",
          "photosPermission": "Choose a photo of a paper record to transcribe."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock the app with Face ID to protect health information."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E0709A"
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Record a short voice note so the hospital knows why you need a call."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a patient's QR code or capture a paper record.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Speak instead of typing — the app turns your words into text.",
          "speechRecognitionPermission": "Speak instead of typing — the app turns your words into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
