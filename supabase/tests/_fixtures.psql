  (:'p_lakshmi', 'MCH-2026-000101', :'m_lakshmi', :'h1', now() - interval '20 weeks', current_date + 49, 2, 1, 1, 0),
  (:'p_sunita',  'MCH-2026-000102', :'m_sunita',  :'h1', now() - interval '10 weeks', current_date + 98, 1, 0, 0, 0),
  (:'p_asha',    'MCH-2026-000104', :'m_asha',    :'h1', now() - interval '25 weeks', current_date + 28, 1, 0, 0, 0),
  (:'p_kavya',   'MCH-2026-000105', :'m_kavya',   :'h1', now() - interval '18 weeks', current_date + 70, 2, 1, 1, 0),
  (:'p_meera',   'MCH-2026-000106', :'m_meera',   :'h1', now() - interval '8 weeks',  current_date + 140, 1, 0, 0, 0);
insert into public.pregnancies (id, mch_id, mother_id, hospital_id, registered_on, edd, gravida, para, living, abortions,
                                status, end_reason, ended_on) values
  (:'p_meena', 'MCH-2026-000103', :'m_meena', :'h1', now() - interval '30 weeks', current_date - 2, 1, 1, 1, 0,
   'delivered', 'delivered', current_date - 2);

-- Every pregnancy has exactly one current dating matching its EDD (checked at commit).
insert into public.pregnancy_datings (pregnancy_id, mother_id, method, lmp, edd, decided_by, decided_at)
select g.id, g.mother_id, 'lmp', g.edd - 280, g.edd, :'s_priya', g.registered_on from public.pregnancies g
where g.id in (:'p_lakshmi', :'p_sunita', :'p_asha', :'p_kavya', :'p_meera', :'p_meena');

